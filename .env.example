# Public canonical origin used for metadataBase, canonical URLs, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Contact address shown on Contact / Privacy / Terms pages (defaults to contact@<your domain>).
NEXT_PUBLIC_CONTACT_EMAIL=

# Google AdSense publisher ID (e.g. ca-pub-1234567890123456). Enables the AdSense code,
# the google-adsense-account verification meta tag and /ads.txt. Leave empty until you apply.
NEXT_PUBLIC_ADSENSE_CLIENT=

# Set to true after enabling Google's certified consent message in AdSense → Privacy & messaging
# (required for visitors in the EEA, UK and Switzerland). Hides the built-in cookie banner.
NEXT_PUBLIC_USE_GOOGLE_CMP=false

# Optional link to a feedback form (e.g. Google Forms) for collecting genuine reviews.
NEXT_PUBLIC_FEEDBACK_URL=

# Partner (affiliate) cards are hidden until you are approved. Set to true and add your links to show them.
NEXT_PUBLIC_SHOW_PARTNERS=false
DEEL_AFFILIATE_URL=https://www.deel.com/
REMOTE_AFFILIATE_URL=https://remote.com/
